{
  "$id": "vmodel.config/1",
  "type": "object",
  "required": [
    "schema",
    "project_id",
    "default_profile",
    "language",
    "python",
    "paths",
    "unit_test",
    "static_analysis"
  ],
  "properties": {
    "schema": {
      "const": "vmodel.config/1"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "default_profile": {
      "enum": [
        "LITE",
        "STANDARD",
        "STRICT"
      ]
    },
    "language": {
      "enum": [
        "python"
      ]
    },
    "python": {
      "type": "string",
      "minLength": 1
    },
    "paths": {
      "type": "object",
      "required": [
        "source",
        "tests",
        "build_config"
      ],
      "properties": {
        "source": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "build_config": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "other": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "unit_test": {
      "type": "object",
      "required": [
        "argv",
        "timeout_s"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "timeout_s": {
          "type": "integer"
        },
        "plugin_autoload": {
          "type": "boolean"
        }
      }
    },
    "static_analysis": {
      "type": "object",
      "required": [
        "lint",
        "on_missing_lint"
      ],
      "properties": {
        "lint": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "name",
            "argv"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "argv": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "on_missing_lint": {
          "enum": [
            "block",
            "syntax-only"
          ]
        }
      }
    }
  }
}
