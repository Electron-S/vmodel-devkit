{
  "$id": "vmodel.review/1",
  "type": "object",
  "required": [
    "gate",
    "work_item",
    "reviewer",
    "target_hash",
    "reviewed_at",
    "verdict",
    "summary",
    "checklist",
    "findings"
  ],
  "properties": {
    "gate": {
      "enum": [
        "G1",
        "G2",
        "G3",
        "G4"
      ]
    },
    "work_item": {
      "type": "string",
      "pattern": "^WI-\\d{3,}$"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "target_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reviewed_at": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "enum": [
        "approve",
        "reject"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "checklist": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "item",
          "result"
        ],
        "properties": {
          "item": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "ok",
              "issue",
              "na"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "description",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "major",
              "minor",
              "info"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "related": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "enum": [
              "open",
              "resolved"
            ]
          }
        }
      }
    }
  }
}
