{
  "$id": "vmodel.requirements/1",
  "type": "object",
  "required": [
    "work_item",
    "requirements",
    "conflict_analysis",
    "open_issues"
  ],
  "properties": {
    "work_item": {
      "type": "string",
      "pattern": "^WI-\\d{3,}$"
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/req"
      }
    },
    "conflict_analysis": {
      "type": "object",
      "required": [
        "performed",
        "conflicts"
      ],
      "properties": {
        "performed": {
          "type": "boolean"
        },
        "method": {
          "type": "string"
        },
        "conflicts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/conflict"
          }
        }
      }
    },
    "open_issues": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/issue"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/assumption"
      }
    }
  },
  "definitions": {
    "req": {
      "type": "object",
      "required": [
        "id",
        "type",
        "title",
        "description",
        "priority",
        "status",
        "acceptance_criteria"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^REQ-\\d{3,}$"
        },
        "type": {
          "enum": [
            "functional",
            "non-functional",
            "constraint"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "enum": [
            "must",
            "should",
            "could"
          ]
        },
        "status": {
          "enum": [
            "active",
            "deleted"
          ]
        },
        "source": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ac"
          }
        }
      }
    },
    "ac": {
      "type": "object",
      "required": [
        "id",
        "criterion"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^AC-\\d{3,}-\\d+$"
        },
        "criterion": {
          "type": "string",
          "minLength": 1
        },
        "given": {
          "type": "string"
        },
        "when": {
          "type": "string"
        },
        "then": {
          "type": "string"
        }
      }
    },
    "conflict": {
      "type": "object",
      "required": [
        "ids",
        "description",
        "status",
        "resolution"
      ],
      "properties": {
        "ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^REQ-\\d{3,}$"
          },
          "minItems": 2
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "open",
            "resolved"
          ]
        },
        "resolution": {
          "type": "string"
        }
      }
    },
    "issue": {
      "type": "object",
      "required": [
        "id",
        "description",
        "critical",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ISSUE-\\d{3,}$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "critical": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "open",
            "resolved"
          ]
        },
        "resolution": {
          "type": "string"
        },
        "decided_by": {
          "enum": [
            "user",
            "assumption",
            "orchestrator"
          ]
        },
        "user_answer": {
          "type": "string"
        }
      }
    },
    "assumption": {
      "type": "object",
      "required": [
        "id",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ASM-\\d{3,}$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "impact": {
          "type": "string"
        }
      }
    }
  }
}
