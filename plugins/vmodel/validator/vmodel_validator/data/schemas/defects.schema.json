{
  "$id": "vmodel.defects/1",
  "type": "object",
  "required": [
    "work_item",
    "defects"
  ],
  "properties": {
    "work_item": {
      "type": "string",
      "pattern": "^WI-\\d{3,}$"
    },
    "defects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "gate",
          "found_in_records",
          "description",
          "root_cause_phase",
          "root_cause",
          "fix_scope",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^DEFECT-\\d{3,}$"
          },
          "gate": {
            "enum": [
              "G1",
              "G2",
              "G3",
              "G4",
              "G5",
              "G6",
              "G7"
            ]
          },
          "found_in_records": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^R\\d{5,}$"
            }
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "failed_checks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "root_cause_phase": {
            "enum": [
              "P1",
              "P2",
              "P3",
              "P4",
              "P5",
              "P6",
              "P7"
            ]
          },
          "root_cause": {
            "type": "string",
            "minLength": 1
          },
          "fix_scope": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "related": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(REQ|AC|ARCH|IF|DESIGN|TEST)-\\d{3,}(-\\d+)?$"
            }
          },
          "removed_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(IF|DESIGN|TEST)-\\d{3,}$"
            }
          },
          "test_changes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "file",
                "since_record",
                "reason",
                "requirements",
                "impact"
              ],
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                },
                "since_record": {
                  "type": "string",
                  "pattern": "^R\\d{5,}$"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "requirements": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^REQ-\\d{3,}$"
                  },
                  "minItems": 1
                },
                "impact": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "status": {
            "enum": [
              "open",
              "fixed"
            ]
          }
        }
      }
    }
  }
}
