{
  "work_item": "WI-001",
  "tests": [
    {"id": "TEST-001", "level": "unit", "title": "p=30 정렬된 5개 값에서 20", "category": "normal",
     "verifies": ["DESIGN-001", "REQ-001"], "procedure": "percentile([15, 20, 35, 40, 50], 30)", "expected": "20 (순위 ceil(30*5/100)=2)",
     "automation": {"file": "tests/test_percentile.py"}},
    {"id": "TEST-002", "level": "unit", "title": "정렬되지 않은 실수 목록", "category": "normal",
     "verifies": ["DESIGN-001", "REQ-001"], "procedure": "percentile([3.5, 1.5, 2.5, 4.5], 50)", "expected": "2.5 (정렬 [1.5, 2.5, 3.5, 4.5], 순위 2)",
     "automation": {"file": "tests/test_percentile.py"}},
    {"id": "TEST-003", "level": "unit", "title": "입력 목록이 변경되지 않음", "category": "normal",
     "verifies": ["DESIGN-001", "REQ-003"], "procedure": "scores = [50, 15, 40, 20, 35]; percentile(scores, 50) 호출 후 scores 확인", "expected": "반환값 35, scores는 여전히 [50, 15, 40, 20, 35]",
     "automation": {"file": "tests/test_percentile.py"}},
    {"id": "TEST-004", "level": "unit", "title": "p 범위 밖이면 ValueError", "category": "abnormal",
     "verifies": ["DESIGN-001", "REQ-002"], "procedure": "percentile([1, 2, 3], 0), percentile([1, 2, 3], 101), percentile([1, 2, 3], -5)", "expected": "세 호출 모두 ValueError",
     "automation": {"file": "tests/test_percentile.py"}},
    {"id": "TEST-005", "level": "unit", "title": "p가 정수가 아니면 ValueError", "category": "abnormal",
     "verifies": ["DESIGN-001", "REQ-002"], "procedure": "percentile([1, 2, 3], 50.5), percentile([1, 2, 3], '50'), percentile([1, 2, 3], True), percentile([1, 2, 3], 50.0)", "expected": "네 호출 모두 ValueError",
     "automation": {"file": "tests/test_percentile.py"}},
    {"id": "TEST-006", "level": "unit", "title": "빈 목록이면 ValueError", "category": "abnormal",
     "verifies": ["DESIGN-001", "REQ-002"], "procedure": "percentile([], 50)", "expected": "ValueError",
     "automation": {"file": "tests/test_percentile.py"}},
    {"id": "TEST-007", "level": "unit", "title": "p=1은 최솟값", "category": "boundary",
     "verifies": ["DESIGN-001"], "procedure": "percentile([40, 15, 50, 20, 35], 1)", "expected": "15",
     "automation": {"file": "tests/test_percentile.py"}},
    {"id": "TEST-008", "level": "unit", "title": "p=100은 최댓값", "category": "boundary",
     "verifies": ["DESIGN-001"], "procedure": "percentile([40, 15, 50, 20, 35], 100)", "expected": "50",
     "automation": {"file": "tests/test_percentile.py"}},
    {"id": "TEST-009", "level": "unit", "title": "원소 1개는 모든 p에서 그 값", "category": "boundary",
     "verifies": ["DESIGN-001"], "procedure": "percentile([7], p) for p in (1, 50, 100)", "expected": "세 호출 모두 7",
     "automation": {"file": "tests/test_percentile.py"}},
    {"id": "TEST-010", "level": "unit", "title": "p*N이 100의 배수일 때 순위 유지", "category": "boundary",
     "verifies": ["DESIGN-001"], "procedure": "percentile([15, 20, 35, 40, 50], 40)", "expected": "20 (순위 정확히 2, 3번째 값 35가 아님)",
     "automation": {"file": "tests/test_percentile.py"}},
    {"id": "TEST-011", "level": "unit", "title": "p=29, N=100 정수 연산 순위", "category": "boundary",
     "verifies": ["DESIGN-001"], "procedure": "percentile(list(range(1, 101)), 29)", "expected": "29 (순위 29, 부동소수점 오차로 30이 되면 실패)",
     "automation": {"file": "tests/test_percentile.py"}},
    {"id": "TEST-012", "level": "unit", "title": "중복 값이 있어도 순위로 선택", "category": "boundary",
     "verifies": ["DESIGN-001"], "procedure": "percentile([5, 5, 5, 9, 1], 80), percentile([5, 5, 5, 9, 1], 100)", "expected": "80 -> 5 (정렬 [1,5,5,5,9], 순위 4), 100 -> 9",
     "automation": {"file": "tests/test_percentile.py"}},
    {"id": "TEST-013", "level": "system", "title": "REQ-001 nearest-rank 예시값", "category": "normal",
     "verifies": ["REQ-001"], "acceptance_criteria": ["AC-001-1", "AC-001-2", "AC-001-3", "AC-001-4", "AC-001-5"],
     "procedure": "scores=[15, 20, 35, 40, 50]에 대해 p=5, 30, 40, 50, 100으로 공개 함수 percentile 호출",
     "expected": "순서대로 15, 20, 20, 35, 50"},
    {"id": "TEST-014", "level": "system", "title": "정렬 안 된 입력과 실수 목록", "category": "normal",
     "verifies": ["REQ-001"], "acceptance_criteria": ["AC-001-6"],
     "procedure": "percentile([50, 20, 15, 40, 35], 30)과 percentile([2.5, 0.5, 1.5], 67) 호출",
     "expected": "20, 2.5 (N=3, 순위 ceil(2.01)=3)"},
    {"id": "TEST-015", "level": "system", "title": "REQ-002 입력 검증 시나리오", "category": "abnormal",
     "verifies": ["REQ-002"], "acceptance_criteria": ["AC-002-1", "AC-002-2", "AC-002-3"],
     "procedure": "percentile([1, 2, 3], 0), percentile([1, 2, 3], 101), percentile([1, 2, 3], 50.5), percentile([1, 2, 3], '50'), percentile([], 50) 호출",
     "expected": "다섯 호출 모두 ValueError"},
    {"id": "TEST-016", "level": "system", "title": "REQ-003 입력 목록 불변 제약", "category": "normal",
     "verifies": ["REQ-003"],
     "procedure": "scores = [40, 15, 50]; 복사본 보관 후 percentile(scores, 50)과 percentile(scores, 100) 호출, 이후 scores와 복사본 비교",
     "expected": "scores가 [40, 15, 50] 그대로이며 순서와 길이가 바뀌지 않음"}
  ]
}
